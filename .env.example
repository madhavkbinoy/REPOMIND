# ---- required ----
# https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Classic token with `public_repo` scope (fine-grained needs Issues + Pull requests: Read-only)
GITHUB_TOKEN=your_github_token_here

# Chat models. llama-3.3-70b-versatile was retired from Groq; these are current.
# MAIN answers and verifies citations; FAST rewrites queries (no reasoning overhead).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=qwen/qwen3.8-27b
# Citation verification: a constrained classification task (does this chunk support this
# claim -> JSON), not open generation, so it runs on the smaller model. Also a separate
# Groq rate-limit pool, which is what makes generation-heavy evaluation runs feasible.
GROQ_MODEL_VERIFY=openai/gpt-oss-20b

# Qdrant. Pick ONE mode -- db/qdrant_client_factory.py selects from the environment:
#   server   : QDRANT_HOST + QDRANT_PORT   (development)
#   embedded : QDRANT_PATH                 (free deployment -- no server process)
#   cloud    : QDRANT_URL + QDRANT_API_KEY
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_PATH=./data/qdrant_embedded
# QDRANT_URL=
# QDRANT_API_KEY=

# Per-IP cap on /api/chat. The Groq free tier allows ~37 questions/day in total,
# so 30/hour lets one visitor consume most of it. Use 5 for a public demo.
RATE_MAX_CALLS=30
RATE_WINDOW_SECONDS=3600

# Redis (Celery only - no worker is started by setup.sh)
REDIS_URL=redis://localhost:6379/0

# SQLite
DATABASE_PATH=./db/repomind.db

# Generation
# Swept against the production gate, on the 37-question human-reviewed golden set.
# This is the first calibration that is both methodologically correct (an earlier
# sweep measured max(score) over reranked chunks, which retrieve() never computes)
# and run on questions a person has vetted.
#
#   0.55 -> 97.3% coverage, 31.8% leak past gate
#   0.60 -> 91.9% coverage, 18.2% leak   <- knee: -5.4 coverage buys -13.6 leak
#   0.65 -> 81.1% coverage,  9.1% leak      (-10.8 buys only -9.1; trade inverts)
#
# The gate is the first of three refusal layers, so leakage here is not the
# hallucination rate. See eval/results.md.
CONFIDENCE_THRESHOLD=0.60

# Corpus scope - kubelet subsystem
KUBELET_ISSUE_LABELS=area/kubelet,component/kubelet
KUBELET_FILE_PREFIX=pkg/kubelet

# scraper_v2: blobless clone used to enumerate commits and derive PR numbers.
# Mainline only by default; set false to include intra-PR branch commits.
CLONE_DIR=./data/repo-clone
COMMITS_FIRST_PARENT=true

# kep_scraper: sig-node KEPs and community docs (git only, no API)
ENHANCEMENTS_DIR=./data/enhancements
COMMUNITY_DIR=./data/community
KEP_SIG=sig-node

# Admin dashboard (api/routes/admin.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CORS origins, comma-separated
ALLOWED_ORIGINS=http://localhost:5173
